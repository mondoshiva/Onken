{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "color": {
      "palette": [
        {"slug": "navy", "name": "Navy", "color": "#102033"},
        {"slug": "deep-navy", "name": "Deep Navy", "color": "#071524"},
        {"slug": "fjord", "name": "Fjord", "color": "#2F80A8"},
        {"slug": "fjord-light", "name": "Fjord Light", "color": "#D9EEF6"},
        {"slug": "ice", "name": "Ice", "color": "#F4F7FA"},
        {"slug": "white", "name": "White", "color": "#FFFFFF"},
        {"slug": "slate", "name": "Slate", "color": "#526171"},
        {"slug": "muted", "name": "Muted", "color": "#7A8794"},
        {"slug": "success", "name": "Success", "color": "#2E7D5B"},
        {"slug": "warning", "name": "Warning", "color": "#C88A2D"},
        {"slug": "border", "name": "Border", "color": "#DDE5EC"}
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        }
      ],
      "fluid": true
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        {"slug": "20", "name": "XS", "size": "0.75rem"},
        {"slug": "30", "name": "S", "size": "1rem"},
        {"slug": "40", "name": "M", "size": "1.5rem"},
        {"slug": "50", "name": "L", "size": "2rem"},
        {"slug": "60", "name": "XL", "size": "3rem"},
        {"slug": "70", "name": "2XL", "size": "4rem"}
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#F4F7FA",
      "text": "#102033"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-sans)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "lineHeight": "1.2",
          "fontWeight": "700"
        },
        "color": {
          "text": "#071524"
        }
      },
      "link": {
        "color": {
          "text": "#2F80A8"
        }
      },
      "button": {
        "color": {
          "background": "#2F80A8",
          "text": "#FFFFFF"
        },
        "border": {
          "radius": "999px"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "bottom": "0.8rem",
            "left": "1.4rem",
            "right": "1.4rem"
          }
        },
        "typography": {
          "fontWeight": "600"
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontWeight": "600"
        }
      }
    }
  },
  "templateParts": [
    {"name": "header", "title": "Header", "area": "header"},
    {"name": "footer", "title": "Footer", "area": "footer"}
  ]
}
